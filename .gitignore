# --- Virtual environments ---------------------------------------------------
.venv/
venv/
env/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Raw datasets (6 GB, re-copyable from the organisers' repo) -------------
# Everything under data/ is ignored except the note that says where it came from.
data/**
!data/
!data/README.md

# --- Generated artefacts ----------------------------------------------------
# outputs/ is entirely generated: checkpoints, predictions, plots, logs. Keep the
# tree, ignore the contents.
outputs/**
!outputs/
!outputs/*/
!outputs/**/.gitkeep

# --- The packaged submission ------------------------------------------------
# The folder we send, rebuilt from scratch by src/submission/package.py every run.
# Anchored: an unanchored rule would match src/submission/ as well and silently
# keep the packaging code itself out of git.
/submission/

# --- Environment / secrets --------------------------------------------------
.env
.env.*
!.env.example

# --- OS / editors -----------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- The pitch video --------------------------------------------------------
# The scene sources and the render's own requirements are code and travel. Every
# recording, the stitched cut and manim's working tree are too large to commit.
video/**
!video/
!video/*/
!video/README.md
!video/requirements.txt
!video/src/*.py
!video/out/.gitkeep
